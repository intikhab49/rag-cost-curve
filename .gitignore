# Datasets: downloadable, and large. build_index prints the URL if missing.
data/raw/

# Built indexes: derived from data/raw + configs/corpus.yaml, and the manifest
# hash means a rebuild is verifiable rather than trusted.
data/corpus/

# LLM response cache: large, and it holds full prompts.
runs/cache/
data/cache/

# Run artefacts are COMMITTED on purpose -- raw.jsonl, calls.jsonl,
# aggregate.json, results.md and the charts are the evidence behind the README
# table. Nothing here excludes them.

__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
